# Database
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=""

# App URL (used for OAuth redirects and email links)
ORIGIN="http://localhost:5173"

# Google OAuth (optional - auth works without these)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# R2 Storage (optional — uploads use in-memory fallback when not configured)
# Set R2_PUBLIC_URL to the public domain of your R2 bucket for production image serving.
# e.g., https://images.darecky.com or https://pub-<hash>.r2.dev
R2_PUBLIC_URL=""
