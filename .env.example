# Database (local Docker)
# MPX injects MPX_DATABASE_PORT=5432; DATABASE_URL remains the shared project DB identity.
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Production database migrations
# Create .env.production (gitignored) with the Neon direct (non-pooled) URL:
#   DATABASE_URL="postgresql://USER:PASS@HOST/dbname?sslmode=require"
# The verifier requires this URL to match the pinned production host/database target.
# Verify first: pnpm db:verify:prod
# Only after reviewing and authorizing every PENDING migration: pnpm db:migrate:prod -- --yes
# Verify again with pnpm db:verify:prod and require EXACT; DRIFT blocks.

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=""

# Canonical URL for production, background jobs, and Google OAuth.
# Interactive email/password auth follows the current localhost request on any port.
# Google OAuth works only on exact origins registered in Google Cloud (8300 by default).
ORIGIN="http://localhost:8300"
BETTER_AUTH_TRUSTED_ORIGINS=""

# Development only: signed-out page loads sign in as this seeded account (e.g. martin@test.cz).
# Signing out pauses it until the next sign-in. Ignored in production and Playwright E2E servers.
DEV_AUTO_LOGIN_EMAIL=""

# App admins (issues #150, #213) — comma-separated emails granted the reserved-list
# revert-to-draft power + the settings gear on active lists (danger actions only), and releasing
# any single reservation plus reading that list's reservation ledger. Every grant stops at the
# obdarovaný. NOT a správce; never appears in list/header/panel UI. Leave empty for no admins.
# In production this is a Worker secret, not a wrangler.jsonc var — see docs/CLOUDFLARE_SETUP.md §E.
ADMIN_EMAILS=""

# In-app AI assistant (issue #478): see docs/API.md#in-app-ai-assistant.
# CHAT_ALLOWED_EMAILS: comma-separated family allowlist; empty shows the assistant to nobody.
# CHAT_DISABLED=true stops new turns. CHAT_PROVIDER is anthropic or fake; development without
# ANTHROPIC_API_KEY runs the scripted fake assistant. CHAT_MODEL defaults to claude-sonnet-5-5.
# In production ANTHROPIC_API_KEY is a Worker secret and the CHAT_ values are dashboard variables.
CHAT_ALLOWED_EMAILS=""
CHAT_DISABLED=""
CHAT_PROVIDER=""
CHAT_MODEL=""
ANTHROPIC_API_KEY=""

# Google OAuth (optional - auth works without these)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare Turnstile (required in production; development uses Cloudflare test keys)
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Sentry error reporting and privacy-masked Session Replay (optional locally; required in production)
# The DSN is public configuration. Source-map credentials are build-only CI settings.
PUBLIC_SENTRY_DSN=""
SENTRY_ORG="martin-poloch"
SENTRY_PROJECT="prejemesi"
SENTRY_AUTH_TOKEN=""

# Email (Resend – optional; emails are logged to console when unset)
# Get an API key at https://resend.com → API Keys.
# EMAIL_FROM uses the sandbox sender until you verify a domain; sandbox only
# delivers to your own Resend account email and the *@resend.dev test addresses.
RESEND_API_KEY=""
EMAIL_FROM="Přejeme si <onboarding@resend.dev>"

# R2 Storage (optional – uploads use in-memory fallback when not configured)
# Set PUBLIC_R2_URL to the public domain of your R2 bucket for production image
# serving + Cloudflare image transformations (issue #107).
# e.g., https://images.prejemesi.cz or https://pub-<hash>.r2.dev
# Empty in local dev: images are served through the same-origin upload route.
PUBLIC_R2_URL=""

# Presigned direct-to-R2 uploads (issue #107, optional). When any of these is
# empty, uploads fall back to the same-origin proxy route (fine for local dev).
# Create an R2 API token (Object Read & Write, scoped to the bucket) in the
# Cloudflare dashboard → R2 → Manage API Tokens.
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Optional test-runner overrides (export in the invoking shell)
# VITEST_SCREENSHOT_FAILURES=false
# E2E_SCREENSHOT_ATTACHMENTS=false
