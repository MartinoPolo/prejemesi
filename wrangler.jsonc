{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "prejemesi",
	"compatibility_date": "2025-05-30",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"keep_vars": true,
	"placement": { "mode": "smart" },
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 0.1,
			"invocation_logs": false,
			"persist": true,
		},
	},
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
	},
	"workers_dev": false,
	"preview_urls": true,
	"routes": [
		{ "pattern": "prejemesi.cz", "custom_domain": true },
		{ "pattern": "www.prejemesi.cz", "custom_domain": true },
	],
	"vars": {
		"ORIGIN": "https://prejemesi.cz",
		// PUBLIC_ prefix: the client builds image + transformation URLs from it (issue #107).
		"PUBLIC_R2_URL": "https://images.prejemesi.cz",
		// PUBLIC_ prefix: the client renders the Cloudflare Turnstile widget from this
		// site key (anonymous gift reservation). Its paired secret is set via
		// `wrangler secret put TURNSTILE_SECRET_KEY`. When absent the check fails open
		// (advisory only) — see reservations.remote.ts and .mpx/DECISIONS.md.
		"PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAD3OIQaYpNZUbwVc",
		// Presigned direct uploads (issue #107). The two secrets that pair with these
		// are set via `wrangler secret put R2_ACCESS_KEY_ID` / `R2_SECRET_ACCESS_KEY`
		// (an R2 API token with Object Read & Write on the bucket). Without them the
		// app falls back to the same-origin upload proxy.
		"R2_ACCOUNT_ID": "7492c3a2a8fad8ffea2f3d0dba97d18f",
		"R2_BUCKET_NAME": "prejemesi-images",
		"EMAIL_FROM": "Přejeme si <noreply@prejemesi.cz>",
		"GOOGLE_CLIENT_ID": "867815684383-d6tg9nlkf7539s0f21divv8u5b9d3ir2.apps.googleusercontent.com",
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "d7f44cea901644ab84ea75b59b9f3118",
			// Dev-only: wrangler/Miniflare emulates Hyperdrive against this local
			// Postgres (see compose.yaml). Ignored on deploy.
			"localConnectionString": "postgres://root:mysecretpassword@localhost:5432/local",
		},
	],
	"r2_buckets": [{ "binding": "R2", "bucket_name": "prejemesi-images" }],
	"ratelimits": [
		// Per personal access token; must match AGENT_API_RATE_LIMIT in
		// src/lib/server/agent_access/limits.ts.
		{
			"name": "AGENT_API_RATE_LIMIT",
			"namespace_id": "1002",
			"simple": { "limit": 120, "period": 60 },
		},
	],
	// Staging (docs/STAGING.md): bindings and vars are not inherited, so each is redeclared
	// with staging resources. Email, Turnstile and presigned uploads stay off.
	"env": {
		"staging": {
			"name": "prejemesi-staging",
			"routes": [{ "pattern": "staging.prejemesi.cz", "custom_domain": true }],
			"vars": {
				"ORIGIN": "https://staging.prejemesi.cz",
				"PUBLIC_R2_URL": "https://staging-images.prejemesi.cz",
				// Production's OAuth client; GOOGLE_CLIENT_SECRET is a staging Worker secret.
				"GOOGLE_CLIENT_ID": "867815684383-d6tg9nlkf7539s0f21divv8u5b9d3ir2.apps.googleusercontent.com",
				// Scripted assistant without API cost; CHAT_ALLOWED_EMAILS is a staging Worker secret.
				"CHAT_PROVIDER": "fake",
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "f18708619a2c44ebaf1ba87bde9f3aef",
					"localConnectionString": "postgres://root:mysecretpassword@localhost:5432/local",
				},
			],
			"r2_buckets": [{ "binding": "R2", "bucket_name": "prejemesi-images-staging" }],
			"ratelimits": [
				{
					"name": "AGENT_API_RATE_LIMIT",
					"namespace_id": "1003",
					"simple": { "limit": 120, "period": 60 },
				},
			],
		},
	},
}
